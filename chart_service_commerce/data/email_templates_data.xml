<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- =====================================================================
             EMAIL TEMPLATES: Service-related communications
             ===================================================================== -->

        <!-- Email verification template -->
        <record id="email_template_service_verification" model="mail.template">
            <field name="name">Service Email Verification</field>
            <field name="model_id" ref="model_chart_service_contract"/>
            <field name="email_from">{{ object.company_id.email }}</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="subject">Verifica tu email para activar tu servicio - {{ object.name }}</field>
            <field name="body_html"><![CDATA[
<div style="font-family: sans-serif; padding: 20px;">
    <h2>Hola {{ object.partner_id.name }},</h2>
    
    <p>¡Gracias por contratar nuestros servicios! Para activar tu contrato, 
    necesitamos que verifiques tu correo electrónico.</p>
    
    <div style="background: #f0f0f0; padding: 20px; margin: 20px 0; border-radius: 5px;">
        <h3>{{ object.name }}</h3>
        <ul>
        {% for product in object.product_ids %}
            <li>{{ product.name }}</li>
        {% endfor %}
        </ul>
    </div>
    
    <p><strong>Próximos pasos:</strong></p>
    <ol>
        <li>Haz clic en el botón de abajo para verificar tu email</li>
        <li>Tu servicio se activará automáticamente en 3 días hábiles</li>
        <li>Recibirás acceso completo y documentación de integración</li>
    </ol>
    
    <center style="margin: 30px 0;">
        <a href="{{ object.env['ir.config_parameter'].sudo().get_param('web.base.url') }}/service/verify-email/{{ object.email_verification_token }}"
           style="background: #1a3c6e; color: white; padding: 12px 30px; text-decoration: none; border-radius: 3px; display: inline-block; font-weight: bold;">
            Verificar Email
        </a>
    </center>
    
    <p style="color: #666; font-size: 12px;">
        Si el botón no funciona, copia y pega este enlace en tu navegador:<br/>
        {{ object.env['ir.config_parameter'].sudo().get_param('web.base.url') }}/service/verify-email/{{ object.email_verification_token }}
    </p>
    
    <p>Este enlace expira en 7 días. Si ya pasó ese tiempo, contacta a nuestro equipo.</p>
    
    <hr style="margin: 30px 0; border: none; border-top: 1px solid #ddd;"/>
    <p style="color: #999; font-size: 12px;">
        Grupo Chart — Soluciones ERP y E-commerce<br/>
        <a href="https://chart.lat">https://chart.lat</a>
    </p>
</div>
            ]]></field>
            <field name="auto_delete">True</field>
        </record>

        <!-- Monthly invoice notification template -->
        <record id="email_template_service_invoice" model="mail.template">
            <field name="name">Service Monthly Invoice Notification</field>
            <field name="model_id" ref="model_account_move"/>
            <field name="email_from">{{ object.company_id.email }}</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="subject">Tu factura mensual de {{ object.service_contract_id.name }}</field>
            <field name="body_html"><![CDATA[
<div style="font-family: sans-serif; padding: 20px;">
    <h2>Hola {{ object.partner_id.name }},</h2>
    
    <p>Tu factura mensual está lista para descarga y pago.</p>
    
    <div style="background: #f9f9f9; padding: 15px; border: 1px solid #ddd; border-radius: 3px; margin: 20px 0;">
        <p><strong>Contrato:</strong> {{ object.service_contract_id.name }}</p>
        <p><strong>Período:</strong> {{ object.invoice_date.strftime('%B %Y') }}</p>
        <p><strong>Total:</strong> {{ object.amount_total | formatLang(lang=object.partner_id.lang, currency_obj=object.currency_id) }}</p>
        <p><strong>Estado:</strong> {{ object.state }}</p>
    </div>
    
    <center style="margin: 30px 0;">
        <a href="{{ object.env['ir.config_parameter'].sudo().get_param('web.base.url') }}/my/invoices/{{ object.id }}"
           style="background: #1a3c6e; color: white; padding: 12px 30px; text-decoration: none; border-radius: 3px; display: inline-block; font-weight: bold;">
            Ver Factura
        </a>
    </center>
    
    <p>Si tienes preguntas sobre esta factura, no dudes en contactarnos.</p>
    
    <hr style="margin: 30px 0; border: none; border-top: 1px solid #ddd;"/>
    <p style="color: #999; font-size: 12px;">
        Grupo Chart<br/>
        <a href="https://chart.lat">https://chart.lat</a>
    </p>
</div>
            ]]></field>
            <field name="auto_delete">True</field>
        </record>

    </data>
</odoo>
