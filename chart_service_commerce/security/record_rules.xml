<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- =====================================================================
             RECORD RULES: Portal and multi-tenant isolation
             ===================================================================== -->

        <!-- Portal users see only their own service contracts -->
        <record id="chart_service_contract_portal_rule" model="ir.rule">
            <field name="name">Service Contract - Portal User Access</field>
            <field name="model_id" ref="chart_service_commerce.model_chart_service_contract"/>
            <field name="domain_force">[('partner_id', 'in', user.partner_id.ids)]</field>
            <field name="groups" ref="base.group_portal"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <!-- Managers see all contracts -->
        <record id="chart_service_contract_manager_rule" model="ir.rule">
            <field name="name">Service Contract - Manager Access</field>
            <field name="model_id" ref="chart_service_commerce.model_chart_service_contract"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" ref="base.group_erp_manager"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">1</field>
        </record>

        <!-- Provisioning tasks: managers only -->
        <record id="chart_provisioning_task_rule" model="ir.rule">
            <field name="name">Provisioning Task - Manager Only</field>
            <field name="model_id" ref="chart_service_commerce.model_chart_provisioning_task"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" ref="base.group_erp_manager"/>
        </record>

        <!-- Service activation: managers only -->
        <record id="chart_service_activation_rule" model="ir.rule">
            <field name="name">Service Activation - Manager Only</field>
            <field name="model_id" ref="chart_service_commerce.model_chart_service_activation"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" ref="base.group_erp_manager"/>
        </record>

    </data>
</odoo>
