<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================
         Banner + confirmación de contratación SIN PAGO en el carrito.
         Cambio focalizado sobre website_sale.cart_lines: no toca la
         navegación, ni las categorías, ni los filtros de /shop.
         ============================================================ -->
    <template id="chart_cart_contract_block" name="Contratar servicio sin pago"
              inherit_id="website_sale.cart_lines" priority="30">
        <xpath expr="//div[@id='cart_products']" position="after">
            <t t-set="chart_has_service" t-value="website_sale_order and website_sale_order.chart_has_services"/>
            <div t-if="chart_has_service" class="card border-primary mt-4"
                 id="chart_contract_block">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Contratación de servicio — sin pago inmediato</h5>
                </div>
                <div class="card-body">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Servicio</th>
                                <th class="text-end">Cant.</th>
                                <th class="text-end">Unitario</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="website_sale_order.chart_service_line_ids" t-as="line">
                                <td>
                                    <span t-out="line.product_id.display_name"/>
                                    <div class="small text-muted">
                                        Periodicidad:
                                        <span t-out="line.product_id.product_tmpl_id.chart_service_periodicity or 'cargo único'"/>
                                    </div>
                                </td>
                                <td class="text-end"><span t-out="line.product_uom_qty"/></td>
                                <td class="text-end"><span t-out="website_sale_order.currency_id.format(line.price_unit)"/></td>
                                <td class="text-end"><span t-out="website_sale_order.currency_id.format(line.price_total)"/></td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="3">Total contratado</th>
                                <th class="text-end"
                                    t-out="website_sale_order.currency_id.format(website_sale_order.amount_total)"/>
                            </tr>
                        </tfoot>
                    </table>
                    <p class="small text-muted mb-3">
                        Al confirmar no se realiza ningún cobro ni se emite factura.
                        El servicio queda <strong>Pendiente de preparación</strong> y
                        lo seguirás en <em>Mis soluciones</em>.
                    </p>
                    <form action="/shop/chart/confirm" method="post"
                          t-att-data-csrf-token="csrf_token">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" name="accept_terms"
                                   id="chart_accept_terms" value="1" required="required"/>
                            <label class="form-check-label small" for="chart_accept_terms">
                                Acepto las condiciones de contratación del servicio y los
                                importes mostrados arriba (quedan guardados con el contrato).
                            </label>
                        </div>
                        <button type="submit" class="btn btn-primary">
                            Confirmar contratación sin pago
                        </button>
                        <a href="/shop/cart" class="btn btn-secondary ms-2">Actualizar carrito</a>
                    </form>
                </div>
            </div>
        </xpath>
    </template>

    <!-- ============================================================
         Página de resumen de contratación (se re-renderiza si faltan
         los términos o hay un error validado en servidor).
         ============================================================ -->
    <template id="chart_checkout_template" name="Resumen de contratación">
        <t t-call="website.layout">
            <div id="wrap">
                <div class="container py-5">
                    <h2>Revisa tu contratación</h2>
                    <div t-if="error" class="alert alert-danger" role="alert" t-out="error"/>
                    <t t-if="order">
                        <table class="table table-striped mt-3">
                            <thead>
                                <tr>
                                    <th>Variante contratada</th>
                                    <th class="text-end">Cantidad</th>
                                    <th class="text-end">Precio unitario</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="order.order_line" t-as="line">
                                    <td><span t-out="line.product_id.display_name"/></td>
                                    <td class="text-end"><span t-out="line.product_uom_qty"/></td>
                                    <td class="text-end"><span t-out="order.currency_id.format(line.price_unit)"/></td>
                                    <td class="text-end"><span t-out="order.currency_id.format(line.price_total)"/></td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th colspan="3">Total</th>
                                    <th class="text-end" t-out="order.currency_id.format(order.amount_total)"/>
                                </tr>
                            </tfoot>
                        </table>
                        <div class="alert alert-info">
                            Pedido <strong t-out="order.name"/> ·
                            <span t-out="order.chart_terms_accepted and 'condiciones aceptadas' or 'condiciones pendientes de aceptar'"/>
                        </div>
                    </t>
                    <a href="/shop/cart" class="btn btn-outline-primary mt-3">Volver al carrito</a>
                </div>
            </div>
        </t>
    </template>
</odoo>
